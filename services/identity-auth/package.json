{
  "name": "@badminton/identity-auth",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:regression": "dotenv -e ../../.env -- node dist/regression/run.js"
  },
  "dependencies": {
    "fastify": "^4.27.0",
    "@badminton/shared-middleware": "workspace:*",
    "@badminton/shared-types": "workspace:*",
    "@badminton/database": "workspace:*",
    "@fastify/jwt": "^8.0.1",
    "@fastify/cookie": "^9.3.1",
    "jose": "^5.9.6",
    "@simplewebauthn/server": "^13.3.3"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "tsx": "^4.10.5",
    "dotenv-cli": "^7.4.2",
    "@badminton/test-harness": "workspace:*",
    "vitest": "^3.2.4"
  }
}
