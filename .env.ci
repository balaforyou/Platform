# .env.ci — F-193 Batch 2. Copied to `.env` by the CI `regression` job
# (.github/workflows/ci.yml) so the per-service `test:regression` scripts, which run
# `dotenv -e ../../.env -- node dist/regression/run.js`, find a DATABASE_URL.
#
# The database name ends in `_test`, which F-101's guard
# (packages/test-harness/src/database-guard.ts) accepts as disposable — the regression
# suites wipe the whole schema with unscoped deletes. The CI Postgres service container
# is ephemeral and created fresh per run; nothing here is a secret.
#
# JWT_SECRET / INTERNAL_SERVICE_KEY are deliberately omitted: the test harness and every
# service fall back to the same hardcoded value when they are unset, so leaving them out
# keeps both sides consistent.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/badminton_db_test?schema=public
