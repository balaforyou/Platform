# F-083: the site address must carry a HOSTNAME for Caddy to provision automatic HTTPS.
# A bare ":80" makes Caddy log one warn line — "server is listening only on the HTTP port,
# so no automatic HTTPS will be applied" — and then serve plain HTTP forever. Nothing
# crashes, nothing reports unhealthy, and the container looks entirely normal.
#
# Defaults to :80 so local and CI stacks are unchanged; production sets SITE_ADDRESS to the
# real domain in .env. The doubled colon is not a typo: {$VAR:default} is Caddy's env
# placeholder syntax and the default here is itself ":80".
{$SITE_ADDRESS::80} {
	# F-302: admin-web's /admin* route removed. Its only login path (phone+OTP) accepted a
	# fixed, guessable OTP (123456) with no rate limit, and the app was still live and
	# publicly reachable in production. Bala's decision: stop serving it rather than fix its
	# login -- admin-web is retired as a live surface, kept in the repo as code reference only
	# (apps/admin-web itself, and its image build/push in CI, are deliberately untouched).
	# Falls through to the guest-member-pwa catch-all below (handle {}), not a 404 -- confirmed
	# real behavior, not assumed.

	handle /api/slot-engine/* {
		uri strip_prefix /api/slot-engine
		reverse_proxy slot-engine:3001
	}

	handle /api/identity/* {
		uri strip_prefix /api/identity
		reverse_proxy identity-auth:3002
	}

	handle /api/tenant/* {
		uri strip_prefix /api/tenant
		reverse_proxy tenant-management:3003
	}

	handle /api/payment/* {
		uri strip_prefix /api/payment
		reverse_proxy payment:3004
	}

	handle /api/notification/* {
		uri strip_prefix /api/notification
		reverse_proxy notification:3005
	}

	# admin-v2 (F-197): its own dedicated host, served from root. Placed after the
	# /api/* handlers (so admin-v2's own API calls still proxy) and before the
	# guest-member-pwa catch-all (which every other unmatched host falls through to).
	@adminV2Host host admin.elitecourts.duckdns.org
	handle @adminV2Host {
		root * /srv/admin-v2
		try_files {path} /index.html
		file_server
	}

	handle {
		root * /srv/guest-member-pwa
		try_files {path} /index.html
		file_server
	}
}
