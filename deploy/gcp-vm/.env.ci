# deploy/gcp-vm/.env.ci — F-193 Batch 2. Copied to `deploy/gcp-vm/.env` by the CI
# `integration` job (.github/workflows/ci.yml), which builds and brings up the real
# shipped stack (deploy/gcp-vm/docker-compose.yml + docker-compose.gcp-verify.yml) to run
# verify-deployment.mjs and the Playwright e2e suite against it.
#
# CI-safe placeholders only, WITH TWO DELIBERATE EXCEPTIONS (see the PUBLIC vs SECRET
# note further down). The compose Postgres is ephemeral and, via
# docker-compose.gcp-verify.yml, published to the runner on 5432 for the e2e seed/migrate
# step — never beyond it. Real deploys use the gitignored deploy/gcp-vm/.env.
#
# ── PUBLIC vs SECRET — read before editing the credential block below ─────────────
# This file's values are baked into the Docker Hub `:caddy` / service images that
# `deploy/gcp-vm/promote.sh` PULLS to production without a rebuild (F-193). So any
# value CI consumes at BUILD time ends up in the shipped production image verbatim.
#
# The two `VITE_*`-consumed build-args (RAZORPAY_KEY_ID -> VITE_RAZORPAY_KEY_ID,
# GOOGLE_OAUTH_CLIENT_ID -> VITE_GOOGLE_CLIENT_ID) are therefore REAL here, on purpose:
# both are public-by-design (a Razorpay *publishable* test key and a Google OAuth
# *client id* both ship in the browser regardless), and with a placeholder the
# production frontend was serving `rzp_test_ci` — a broken checkout (Bug 2 / F-038
# addendum, 30 Aug 2026).
#
# Everything else — every *_SECRET, JWT_SECRET, POSTGRES_PASSWORD, INTERNAL_SERVICE_KEY —
# STAYS FAKE. Those are backend-runtime only, genuinely sensitive, and the production
# VM supplies real ones via its own gitignored .env. Do not "make CI real" for those.
# ─────────────────────────────────────────────────────────────────────────────────
#
# SITE_ADDRESS=:80 so Caddy serves plain HTTP (no cert provisioning) — verify-deployment
# and Playwright both hit http://localhost:8080.
# NODE_ENV=development matches how the real demo VM runs (OTP 123456, phone self-register)
# which the e2e specs depend on.
SITE_ADDRESS=:80

POSTGRES_DB=badminton_db
POSTGRES_USER=badminton
POSTGRES_PASSWORD=ci-postgres-password

DATABASE_URL=postgresql://badminton:ci-postgres-password@postgres:5432/badminton_db?schema=public
JWT_SECRET=ci-jwt-secret
INTERNAL_SERVICE_KEY=ci-internal-service-key

# REAL — public-by-design (see the PUBLIC vs SECRET note in the header). Consumed as
# the VITE_RAZORPAY_KEY_ID build-arg -> baked into guest-member-pwa's bundle. Same
# publishable test key as .env.example and BookingPay.tsx's history. A placeholder
# here ships a broken checkout to production.
RAZORPAY_KEY_ID=rzp_test_TJllXnaezST7MV
# FAKE — backend-runtime secret, stays fake. The real one is on the VM.
RAZORPAY_KEY_SECRET=ci-razorpay-secret
# FAKE — backend-runtime secret, stays fake.
RAZORPAY_WEBHOOK_SECRET=ci-razorpay-webhook-secret

# REAL — public-by-design (F-203). Consumed as the VITE_GOOGLE_CLIENT_ID build-arg ->
# baked into admin-v2's bundle; also identity-auth's Google `aud`. A Google OAuth
# client id is not a secret (it is in every OAuth request); only the client *secret*
# is, and admin-v2 uses none. WEBAUTHN_RP_* stay unset — the compose defaults
# (admin.elitecourts.duckdns.org) apply; CI does not run the WebAuthn ceremony.
GOOGLE_OAUTH_CLIENT_ID=861109681806-fhuch1ct1kjrmaie9lo4fpubta7k78e3.apps.googleusercontent.com

SLOT_ENGINE_URL=http://slot-engine:3001
TENANT_SERVICE_URL=http://tenant-management:3003
IDENTITY_SERVICE_URL=http://identity-auth:3002
NOTIFICATION_SERVICE_URL=http://notification:3005

NODE_ENV=development
