FROM node:22-bookworm-slim AS build
WORKDIR /app

# WHY (F-078): Corepack otherwise prompts "Do you want to continue? [Y/n]" before
# downloading pnpm, which hangs a scripted deploy indefinitely with no error and no
# timeout. The packageManager pin in the root package.json removes the reason it asks;
# this guarantees it can never block regardless.
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl \
  && rm -rf /var/lib/apt/lists/*
RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json ./
COPY packages ./packages
COPY services ./services

RUN pnpm install --frozen-lockfile
RUN pnpm --filter @badminton/shared-types run build
RUN pnpm --filter @badminton/shared-middleware run build
RUN pnpm --filter @badminton/database run prisma:generate
RUN pnpm --filter @badminton/database run build
# F-313: a genuinely clean build (verified: cleared docker builder cache, built from empty)
# surfaced this exact same gap twice. Neither package had an explicit build step here --
# both silently depended on a host-prebuilt dist riding along inside `COPY packages ./packages`,
# invisible only because no .dockerignore existed to ever exclude it. Built explicitly now,
# same pattern as the three packages above, so this image no longer depends on host state.
# @badminton/job-scheduler: a real, non-test runtime dependency of slot-engine's src/index.ts.
RUN pnpm --filter @badminton/job-scheduler run build
# @badminton/test-harness: every service's src/regression/*.ts imports this (tsconfig's
# `include: ["src/**/*"]` compiles them as part of the ordinary `run build`, same as
# production source, for every one of the 5 services this Dockerfile builds).
RUN pnpm --filter @badminton/test-harness run build

ARG SERVICE_PACKAGE
RUN pnpm --filter ${SERVICE_PACKAGE} run build

FROM node:22-bookworm-slim AS runtime
WORKDIR /app

ENV NODE_ENV=production
ENV NODE_OPTIONS=--max-old-space-size=96
# F-078: same reason as the build stage — this stage runs corepack too.
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl \
  && rm -rf /var/lib/apt/lists/*
RUN corepack enable

COPY --from=build /app /app

# WHY (F-077): the SHA this image was BUILT from, baked in. The deploy separately supplies
# the SHA it INTENDS to run (EXPECTED_GIT_SHA); any difference means this image is stale.
# Counting migrations cannot detect that — a stale image and its database agree with each
# other. Only build-time vs deploy-time comparison catches it.
ARG GIT_SHA=unknown
ENV BUILD_GIT_SHA=$GIT_SHA

ARG SERVICE_PATH
WORKDIR /app/${SERVICE_PATH}

CMD ["node", "dist/index.js"]
