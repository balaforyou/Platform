datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

enum AllocationMode {
  FIXED_INSTANCE
  POOLED
}

enum PricingMode {
  FLAT
  PER_PERSON
}

enum BookingStatus {
  HELD
  CONFIRMED
  CHECKED_IN
  RELEASED_NO_SHOW
  CANCELLED
}

enum AvailabilityOverrideType {
  CLOSED
  MODIFIED
}

enum BranchStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

// F-206: per-tenant module entitlement. The four sellable modules; a tenant with no
// ModuleEntitlement row for a given module is not entitled to it (fail-closed default).
enum TenantModule {
  GUEST_BOOKING
  MEMBER_MANAGEMENT
  STUDENT_MANAGEMENT
  TOURNAMENT
}

enum UserRole {
  OWNER
  BRANCH_MANAGER
  FRONT_DESK
}

model Tenant {
  id               String           @id @default(uuid())
  name             String
  subdomain        String           @unique
  logo             String?
  themeColor       String           @default("#000000")
  appName          String?
  plan             String           @default("basic")
  status           String           @default("active")
  contactInfo      String?
  billingInfo      String?
  // Facilities / About — tenant-level defaults; branches may override
  aboutDescription String?
  facilities       String[]         @default([])
  photos           String[]         @default([])
  branches         Branch[]
  roleAssignments  RoleAssignment[]
  moduleEntitlements ModuleEntitlement[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

// F-206: one row per (tenant, module). Renewal extends this row's endDate — no new row per
// term (same shape as F-207's confirmed renewal design). State is a pure function of
// (now, startDate, endDate, disabledAt), computed at every access point, never stored:
//   no row / now < startDate / now > endDate  -> denied
//   startDate <= now <= endDate, no disabledAt -> read + write
//   disabledAt set, now <= endDate             -> read only (Owner early wind-down)
model ModuleEntitlement {
  id         String       @id @default(uuid())
  tenantId   String
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  module     TenantModule
  startDate  DateTime
  endDate    DateTime
  disabledAt DateTime?    // set when an Owner confirms early wind-down; endDate is left untouched
  disabledBy String?      // userId of the Owner who disabled it
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([tenantId, module])
}

model Branch {
  id                String           @id @default(uuid())
  tenantId          String
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name              String
  address           String?
  // Location / outbound links. Coordinates are stored rather than derived from googlePlaceId:
  // deriving would need a Google Places lookup (API key, billing, a network failure mode on the
  // guest path) to recover two numbers we already hold.
  // WHY Float and not Decimal: Prisma serialises Decimal as a *string* in JSON — the existing
  // price/refundAmount fields already behave that way — which would force client-side parsing
  // before a coordinate could go into a maps URL. Float maps to DOUBLE PRECISION and is exact
  // far beyond the ~1cm these values carry.
  latitude          Float?                          // decimal degrees, e.g. 11.0375013
  longitude         Float?                          // decimal degrees, e.g. 76.9330389
  googlePlaceId     String?                         // e.g. ChIJDeozArlYqDsRUA0SRJPRn1E
  timezone          String           @default("UTC")
  status            BranchStatus     @default(DRAFT)
  // Operating schedule
  workingDays       String[]         @default([])  // e.g. ["Monday", "Tuesday", ...]
  workingHoursStart String?                        // e.g. "06:00" (HH:mm, branch local time)
  workingHoursEnd   String?                        // e.g. "22:00"
  // Facilities / About — overrides tenant-level defaults when non-empty
  aboutDescription  String?
  facilities        String[]         @default([])
  photos            String[]         @default([])
  roleAssignments   RoleAssignment[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([tenantId, name])
}

model RoleAssignment {
  id        String   @id @default(uuid())
  userId    String
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  role      UserRole
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // WHY (F-115): one assignment per user per scope, so re-running an assignment updates
  // the role in place instead of inserting a second row. The real index is created with
  // NULLS NOT DISTINCT, which Prisma 5.14 cannot express here — see the F-115 migration.
  // That matters because OWNER rows carry branchId = null, and a plain unique index would
  // let the same owner be inserted twice, which is the exact bug this prevents.
  // DO NOT regenerate this index from the schema alone: it would come back plain and
  // silently lose owner-duplicate protection. The role-scoping regression catches that.
  // WHY userId is in the key (F-117): multiple owners per tenant is a supported
  // capability; keying on (tenantId, role) would break it.
  @@unique([userId, tenantId, branchId])
  @@index([userId, tenantId])
}

model ResourcePool {
  id                        String                  @id @default(uuid())
  tenantId                  String                  // Scalar UUID, no DB relation yet
  branchId                  String                  // Scalar UUID, no DB relation yet
  name                      String
  allocationMode            AllocationMode
  capacity                  Int                     @default(1)         // Total capacity for POOLED mode
  basePrice                 Decimal                 @default(100.00) @db.Decimal(10, 2) // Legacy; kept for compatibility
  // Occupancy / duration constraints
  minOccupancy              Int                     @default(1)         // Minimum players required to book
  minBookingDurationMinutes Int                     @default(60)        // Minimum slot duration in minutes
  // Pricing mode and rate (used when AvailabilityWindow has no override)
  pricingMode               PricingMode             @default(FLAT)
  defaultRate               Decimal                 @default(100.00) @db.Decimal(10, 2)
  resources                 Resource[]
  availabilityWindows       AvailabilityWindow[]
  availabilityPatterns      AvailabilityPattern[]
  availabilityOverrides     AvailabilityOverride[]
  generationLocks           GenerationLock[]
  bookingRules              BookingRule[]
  blockedWindows            BlockedWindow[]
  bookings                  Booking[]
  memberGroupAssignments    MemberGroupAssignment[]
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
}

model Resource {
  id                  String               @id @default(uuid())
  resourcePoolId      String
  resourcePool        ResourcePool         @relation(fields: [resourcePoolId], references: [id], onDelete: Cascade)
  name                String
  availabilityWindows AvailabilityWindow[]
  bookings            Booking[]
  blockedWindows      BlockedWindow[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  // WHY (SCREEN-002): generation emits one availability window per resource, so two courts
  // sharing a name in one pool produce two indistinguishable sets of bookable slots. The
  // onboarding wizard collects these names as free text, which makes a duplicate one stray
  // keystroke away. Unlike F-115's index this needs no NULLS NOT DISTINCT — both columns are
  // NOT NULL, so there is no null case for it to cover.
  @@unique([resourcePoolId, name])
}

model AvailabilityWindow {
  id             String       @id @default(uuid())
  resourcePoolId String
  resourcePool   ResourcePool @relation(fields: [resourcePoolId], references: [id], onDelete: Cascade)
  resourceId     String?
  resource       Resource?    @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  startTime      DateTime
  endTime        DateTime
  capacity       Int          @default(1)  // Capacity count for POOLED mode (always 1 for FIXED_INSTANCE)
  generatedFromPatternId String?
  generationDate DateTime?
  // Per-release pricing override; null means "use pool default".
  // WHY: Both fields are always set together (both-or-neither rule enforced at API layer).
  pricingMode    PricingMode?
  price          Decimal?     @db.Decimal(10, 2)
  bookings       Booking[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([startTime, endTime])
}

model AvailabilityPattern {
  id                  String       @id @default(uuid())
  resourcePoolId      String
  resourcePool        ResourcePool @relation(fields: [resourcePoolId], references: [id], onDelete: Cascade)
  daysOfWeek          String
  startTime           String
  endTime             String
  slotDurationMinutes Int
  capacity            Int
  pricingMode         PricingMode?
  price               Decimal?     @db.Decimal(10, 2)
  status              String       @default("ACTIVE")
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([resourcePoolId, status])
}

model AvailabilityOverride {
  id                  String                   @id @default(uuid())
  resourcePoolId      String
  resourcePool        ResourcePool             @relation(fields: [resourcePoolId], references: [id], onDelete: Cascade)
  date                DateTime
  type                AvailabilityOverrideType
  startTime           String?
  endTime             String?
  slotDurationMinutes Int?
  capacity            Int?
  pricingMode         PricingMode?
  price               Decimal?                 @db.Decimal(10, 2)
  reason              String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@unique([resourcePoolId, date])
  @@index([resourcePoolId, date])
}

model GenerationLock {
  id             String       @id @default(uuid())
  resourcePoolId String
  resourcePool   ResourcePool @relation(fields: [resourcePoolId], references: [id], onDelete: Cascade)
  date           DateTime
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([resourcePoolId, date])
}

model ScheduledJob {
  name                String    @id
  enabled             Boolean   @default(true)
  intervalSeconds     Int
  timeoutSeconds      Int       @default(60)
  nextRunAt           DateTime
  lastRunAt           DateTime?
  lastRunStatus       String?
  lastRunError        String?
  lastRunDurationMs   Int?
  consecutiveFailures Int       @default(0)
  circuitOpenedAt     DateTime?
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([enabled, nextRunAt])
}

model ScheduledJobDispatch {
  id           String    @id @default(uuid())
  jobName      String
  tenantId     String?
  subjectId    String?
  dedupKey     String
  status       String    @default("PENDING")
  attempts     Int       @default(0)
  lastError    String?
  occurrenceAt DateTime?
  expiresAt    DateTime?
  dispatchedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([jobName, dedupKey])
  @@index([jobName, status, createdAt])
  @@index([expiresAt])
}

model BookingRule {
  id                       String       @id @default(uuid())
  resourcePoolId           String
  resourcePool             ResourcePool @relation(fields: [resourcePoolId], references: [id], onDelete: Cascade)
  memberWindowDays         Int          @default(30)
  guestOpenWindowDays      Int          @default(7)
  // WHY: Two distinct time-based mechanisms — never conflate them.
  // gracePeriodMinutes: governs individual member seat release deadline (member confirmed → RELEASED_NO_SHOW).
  gracePeriodMinutes       Int          @default(30)
  // guestAccessCutoffMinutes: governs when sweep fires low-occupancy alert + admin can release freed capacity to guests.
  guestAccessCutoffMinutes Int          @default(120)
  // lowOccupancyThresholdPct: admin-configurable percentage below which low-occupancy alert fires.
  lowOccupancyThresholdPct Int          @default(50)
  prepaymentRequired       Boolean      @default(true)
  cancellationPolicyJson   Json         // Tiered policy mapping: { type: "tiered", tiers: [{ min_hours_before_slot, refund_percent }] }
  // F-183 Phase 1: cap on additional contiguous AvailabilityWindows a guest may add to a
  // single booking (0 = no extension allowed for this pool). Default of 1 changes no
  // existing behavior — additionalWindowIds is opt-in per request.
  maxAdditionalWindows     Int          @default(1)
  // F-184: cap on active (HELD + CONFIRMED) self-service Bookings a guest may hold per
  // branch-local calendar day, counted across every pool in the branch. Default of 3
  // changes no existing behavior for pools that never set it explicitly.
  maxDailyBookingsPerGuest Int          @default(3)
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  // WHY (F-067): every reader takes bookingRules[0] or findFirst, so a pool with two rows
  // has a non-deterministic effective policy — payment, refund and cutoff behaviour would
  // vary between requests. One rule per pool is the invariant those readers already assume;
  // this makes the database enforce it rather than hope for it.
  @@unique([resourcePoolId])
}

model BlockedWindow {
  id             String        @id @default(uuid())
  resourcePoolId String
  resourcePool   ResourcePool  @relation(fields: [resourcePoolId], references: [id], onDelete: Cascade)
  resourceId     String?
  resource       Resource?     @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  startTime      DateTime
  endTime        DateTime
  reason         String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

// WHY: Represents a member's recurring slot assignment for a specific court/pool.
// Enforces Basic-tier "one recurring slot per member" rule via:
//   1. Standard @@unique([userId, resourcePoolId]) — prevents same-court double-assignment.
//   2. A Postgres partial unique index on (userId) WHERE status = 'ACTIVE' (added as raw SQL
//      in the migration file — Prisma schema syntax cannot express WHERE-clause indexes).
//      This enforces the one-active-slot-per-member rule at DB level, making concurrent
//      assignment requests fail with P2002 rather than relying on app-level pre-checks.
model MemberGroupAssignment {
  id             String       @id @default(uuid())
  userId         String
  resourcePoolId String
  resourcePool   ResourcePool @relation(fields: [resourcePoolId], references: [id], onDelete: Cascade)
  // Schedule fields — explicit days+time rather than a full cron expression.
  // WHY: The requirement is weekdays + one fixed start time; cron syntax adds parser complexity
  // for no benefit when the constraint is this narrow.
  daysOfWeek     String       // e.g. "1,2,3,4,5,6" (1=Mon … 7=Sun, ISO weekday)
  startTime      String       // e.g. "10:00" (HH:mm, branch local time)
  status         String       // ACTIVE | SUSPENDED
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([userId, resourcePoolId])
}

model Booking {
  id             String         @id @default(uuid())
  tenantId       String         // Scalar UUID, no DB relation yet
  branchId       String         // Scalar UUID, no DB relation yet
  resourcePoolId String
  resourcePool   ResourcePool   @relation(fields: [resourcePoolId], references: [id], onDelete: Cascade)
  resourceId     String?
  resource       Resource?      @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  // F-186: display-only "Court N" number for POOLED pools with no real per-court resourceId
  // tracking. Assigned once per booking, identical on parent and every child. Null when no
  // common index is free across every window the booking touches — degrades to today's
  // no-court-shown state rather than rejecting the booking or showing an unstable number.
  courtSlotIndex Int?
  windowId       String
  window         AvailabilityWindow @relation(fields: [windowId], references: [id], onDelete: Cascade)
  userId         String
  status         BookingStatus
  heldAt         DateTime       @default(now())
  heldUntil      DateTime
  idempotencyKey String?        @unique // unique check for API requests
  isMemberBooking Boolean       @default(false)
  // WHY: Member booking existence and attendance confirmation are distinct states.
  // The grace sweep releases only member bookings where this is still null.
  memberAttendanceConfirmedAt DateTime?
  price          Decimal?       @db.Decimal(10, 2)
  refundAmount   Decimal?       @db.Decimal(10, 2)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  players        BookingPlayer[]
  // F-183 Phase 1: a multi-window booking is one billable parent plus N-1 lightweight
  // child rows (one per additional contiguous hour), each occupying its own
  // AvailabilityWindow so every existing windowId-keyed query is untouched. Children
  // carry price: null, idempotencyKey: null (multiple NULLs are permitted under the
  // existing @unique above).
  parentBookingId String?
  parentBooking   Booking?        @relation("BookingChildren", fields: [parentBookingId], references: [id], onDelete: Cascade)
  childBookings   Booking[]       @relation("BookingChildren")

  @@index([status, heldUntil])
  @@index([parentBookingId])
}

enum UserType {
  GUEST
  MEMBER
  STAFF
}

model User {
  id              String        @id @default(uuid())
  tenantId        String        // Scalar UUID, namespaced per tenant
  phone           String?
  email           String?
  googleId        String?
  isPhoneVerified Boolean       @default(false)
  isEmailVerified Boolean       @default(false)
  userType        UserType      @default(GUEST)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  sessions        AuthSession[]
  webAuthnCredentials WebAuthnCredential[]

  @@unique([phone, tenantId])
  @@unique([email, tenantId])
  @@unique([googleId, tenantId])
}

model AuthSession {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @unique
  expiresAt    DateTime
  revoked      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// F-196: WebAuthn / fingerprint step-up for admin-v2. A credential is only ever created
// by an already-Google-authenticated admin (see identity-auth /auth/admin/webauthn/register).
// Fields per docs/plans/admin-v2-slice1-plan-mode-SIGNED.md §3.
model WebAuthnCredential {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String   @unique // base64url; the assertion lookup key for discoverable login
  publicKey    Bytes
  counter      BigInt   @default(0)
  deviceLabel  String?
  createdAt    DateTime @default(now())

  @@index([userId])
}

model PendingInvite {
  id        String   @id @default(uuid())
  tenantId  String
  phone     String
  createdAt DateTime @default(now())

  @@unique([phone, tenantId])
}

model OtpRequest {
  id        String   @id @default(uuid())
  phone     String
  tenantId  String
  code      String
  ip        String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone, createdAt])
  @@index([ip, createdAt])
}

model BookingPlayer {
  id        String   @id @default(uuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  userId    String?  // Resolved once they register/login
  phone     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bookingId, phone])
  @@index([phone, userId])
}

model PaymentIntent {
  id          String   @id @default(uuid())
  tenantId    String
  userId      String
  amount      Int      // in paise/cents
  purpose     String   // guest_booking | tournament_entry | subscription_billing
  referenceId String   // bookingId or subscriptionId
  status      String   // pending | captured | failed | expired
  gatewayRef  String   @unique
  refunds     Refund[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Subscription {
  id        String   @id @default(uuid())
  userId    String
  tenantId  String
  mandateId String   @unique
  amount    Int      // in paise/cents
  frequency String   // monthly
  status    String   // active | suspended | cancelled
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Refund {
  id              String        @id @default(uuid())
  paymentIntentId String
  paymentIntent   PaymentIntent @relation(fields: [paymentIntentId], references: [id], onDelete: Cascade)
  amount          Int           // in paise/cents
  reason          String
  status          String        // pending | processed | failed
  // Override audit trail — populated only when isOverride = true.
  // WHY: overriddenBy is always derived from the verified JWT at the API layer, never from request body.
  isOverride      Boolean       @default(false)
  overriddenBy    String?       // userId from JWT
  overrideReason  String?
  overrideAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model WebhookEvent {
  id             String   @id @default(uuid())
  gatewayEventId String   @unique
  createdAt      DateTime @default(now())
}

model NotificationTemplate {
  id           String   @id @default(uuid())
  tenantId     String   @default("platform")
  channel      String   // sms | push | email
  eventType    String
  templateBody String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, channel, eventType])
}

model NotificationRequest {
  id           String    @id @default(uuid())
  tenantId     String
  recipient    String    // userId, or raw mobile/email
  channel      String    // sms | push | email
  eventType    String
  variables    Json
  status       String    // queued | sent | failed | dead_letter
  attempts     Int       @default(0)
  retryAfter   DateTime?
  providerRef  String?
  errorMessage String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
