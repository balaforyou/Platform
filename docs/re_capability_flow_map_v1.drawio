7" value="&lt;b&gt;FLOW-037&lt;/b&gt;&lt;br&gt;&lt;i&gt;Cancel Booking&lt;/i&gt;&lt;br&gt;&lt;font size=&apos;9&apos; color=&apos;#555555&apos;&gt;POST /bookings/:id/cancel&lt;/font&gt;&lt;br&gt;&lt;font size=&apos;8&apos; color=&apos;#6c8ebf&apos;&gt;TRANSITION-BOOKING-006 / -007 / -008&lt;/font&gt;&lt;br&gt;&lt;font size=&apos;8&apos; color=&apos;#b85450&apos;&gt;F-092&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=4;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="640" y="550" width="250" height="86" as="geometry"/></mxCell><mxCell id="j059" value="&lt;b&gt;FLOW-059&lt;/b&gt;&lt;br&gt;&lt;i&gt;Create Refund&lt;/i&gt;&lt;br&gt;&lt;font size=&apos;9&apos; color=&apos;#555555&apos;&gt;POST /refunds&lt;/font&gt;&lt;br&gt;&lt;font size=&apos;8&apos; color=&apos;#6c8ebf&apos;&gt;TRANSITION-REFUND-001&lt;/font&gt;&lt;br&gt;&lt;font size=&apos;8&apos; color=&apos;#b85450&apos;&gt;F-026 F-082 F-097 (fixed)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=4;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="940" y="550" width="250" height="86" as="geometry"/></mxCell><mxCell id="j060" value="&lt;b&gt;FLOW-060&lt;/b&gt;&lt;br&gt;&lt;i&gt;Override Refund&lt;/i&gt;&lt;br&gt;&lt;font size=&apos;9&apos; color=&apos;#555555&apos;&gt;POST /refunds/override&lt;/font&gt;&lt;br&gt;&lt;font size=&apos;8&apos; color=&apos;#b85450&apos;&gt;F-026&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=4;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1240" y="550" width="250" height="86" as="geometry"/></mxCell><mxCell id="je0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;" edge="1" parent="1" source="j024" target="j029"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="je1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1