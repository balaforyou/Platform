ue="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;" edge="1" parent="1" source="j034" target="j036"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="je12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;" edge="1" parent="1" source="j036" target="j037"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="je13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;" edge="1" parent="1" source="j037" target="j059"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="je14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;" edge="1" parent="1" source="j059" target="j060"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="je15" value="releases stale HELD" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;dashed=1;strokeColor=#b85450;" edge="1" parent="1" source="j049" target="j029"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="jn" value="&lt;b&gt;RE-011 journey integrity (current file)&lt;/b&gt;&lt;br&gt;Standard Guest Booking &lt;b&gt;WEAK&lt;/b&gt; &amp;bull; Booking Confirmation &lt;b&gt;WEAK&lt;/b&gt; &amp;bull; Check-In &lt;b&gt;WEAK&lt;/b&gt; &amp;bull; Payment &lt;b&gt;WEAK&lt;/b&gt; &amp;bull; Refund &lt;b&gt;INCOMPLETE&lt;/b&gt; &amp;bull; Cancellation CONSISTENT_WITH_VARIANTS&lt;br&gt;&lt;br&gt;&lt;b&gt;Edges are RE-004&apos;s reconstruction, not an established contract.&lt;/b&gt; FLOW-DISCOVERY-UNCERTAINTY-002 states RE-003 could not determine the lifecycle/ownership boundary between booking, payment, cancellation and refund — precisely this chain.&lt;br&gt;&lt;b&gt;FLOW-037 does not create a Refund row&lt;/b&gt;; FLOW-059 is a separate journey (XFLOW-GAP-003)." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="1200" height="150" as=