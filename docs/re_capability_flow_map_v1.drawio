<mxfile host="app.diagrams.net" agent="generate-flow-diagram.mjs" version="24.0.0" type="device"><diagram id="cap-map" name="0 · Capability Map"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="&lt;b&gt;Reverse-Engineered Capability &amp;amp; Flow Map — v1 (demo scope)&lt;/b&gt;&lt;br&gt;&lt;font size=&apos;10&apos;&gt;Keyed to real FLOW-/CAP- IDs. Click any capability to open its flow page.&lt;/font&gt;" style="text;html=1;align=left;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="50" as="geometry"/></mxCell><mxCell id="lg" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;font color=&apos;#82b366&apos;&gt;&amp;#9632;&lt;/font&gt; authenticated &amp;nbsp; &lt;font color=&apos;#b85450&apos;&gt;&amp;#9632;&lt;/font&gt; NO auth (defect) &amp;nbsp; &lt;font color=&apos;#d6b656&apos;&gt;&amp;#9632;&lt;/font&gt; public by design &amp;nbsp; &lt;font color=&apos;#d79b00&apos;&gt;&amp;#9632;&lt;/font&gt; provider signature &amp;nbsp; &lt;font color=&apos;#9673a6&apos;&gt;&amp;#9632;&lt;/font&gt; no endpoint (module) &amp;nbsp; &lt;font color=&apos;#999999&apos;&gt;&amp;#9632;&lt;/font&gt; test-only&lt;br&gt;Blue line = RE-006 transition &amp;nbsp; Red text = finding id" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1120" y="20" width="440" height="100" as="geometry"/></mxCell><object label="&lt;b&gt;CAP-005&lt;/b&gt;&lt;br&gt;Resource Management&lt;br&gt;&lt;font size=&apos;9&apos; color=&apos;#555555&apos;&gt;4 flows &amp;bull; &lt;font color=&apos;#b85450&apos;&gt;0 rule coverage&lt;/font&gt;&lt;/font&gt;" link="data:page/id,cap-005" id="mCAP-005"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=6;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="260" height="80" as="geometry"/></mxCell></object><object label="&lt;b&gt;CAP-006&lt;/b&gt;&lt;br&gt;Availability &amp;amp; Scheduling&lt;br&gt;&lt;font size=&apos;9&apos; color=&apos;#555555&apos;&gt;6 flows &amp;bull; &lt;font color=&apos;#b85450&apos;&gt;5 of 6 uncovered&lt;/font&gt;&lt;/font&gt;" link="data:page/id,cap-006" id="mCAP-006"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=6;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="340" y="120" width="260" height="80" as="geometry"/></mxCell></object><object label="&lt;b&gt;CAP-008&lt;/b&gt;&lt;br&gt;Booking Rule Configuration&lt;br&gt;&lt;font size=&apos;9&apos; color=&apos;#555555&apos;&gt;2 flows &amp;bull; &lt;font color=&apos;#b85450&apos;&gt;0 rule coverage&lt;/font&gt;&lt;/font&gt;" link="data:page/id,cap-008" id="mCAP-008"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=6;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="640" y="120" width="260" height="80" as="geometry"/></mxCell></object><object label="&lt;b&gt;CAP-007&lt;/b&gt;&lt;br&gt;Booking Management&lt;br&gt;&lt;font size=&apos;9&apos; color=&apos;#555555&apos;&gt;8 flows &amp;bull; full coverage&lt;/font&gt;" link="data:page/id,cap-007" id="mCAP-007"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=6;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="340" y="300" width="260" height="80" as="geometry"/></mxCell></object><object label="&lt;b&gt;CAP-010&lt;/b&gt;&lt;br&gt;Occupancy &amp;amp; Capacity Release&lt;br&gt;&lt;font size=&apos;9&apos; color=&apos;#555555&apos;&gt;5 flows &amp;bull; &lt;font color=&apos;#b85450&apos;&gt;3 of 5 uncovered&lt;/font&gt;&lt;/font&gt;" link="data:page/id,cap-010" id="mCAP-010"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=6;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="260" height="80" as="geometry"/></mxCell></object><object label="&lt;b&gt;CAP-011&lt;/b&gt;&lt;br&gt;Payment &amp;amp; Refund&lt;br&gt;&lt;font size=&apos;9&apos; color=&apos;#555555&apos;&gt;7 flows &amp;bull; full coverage&lt;/font&gt;" link="data:page/id,cap-011" id="mCAP-011"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=6;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="640" y="300" width="260" height="80" as="geometry"/></mxCell></object><object label="&lt;b&gt;JOURNEY&lt;/b&gt;&lt;br&gt;Guest Booking + Payment&lt;br&gt;&lt;font size=&apos;9&apos; color=&apos;#555555&apos;&gt;cross-flow view&lt;/font&gt;" link="data:page/id,guest-booking" id="mj0"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=6;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="340" y="480" width="260" height="80" as="geometry"/></mxCell></object><mxCell id="ce0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;" edge="1" parent="1" source="mCAP-005" target="mCAP-006"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ce1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;" edge="1" parent="1" source="mCAP-006" target="mCAP-007"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ce2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;" edge="1" parent="1" source="mCAP-008" target="mCAP-007"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ce3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;" edge="1" parent="1" source="mCAP-005" target="mCAP-010"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ce4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;" edge="1" parent="1" source="mCAP-007" target="mCAP-010"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ce5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;" edge="1" parent="1" source="mCAP-007" target="mCAP-011"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n0" value="&lt;b&gt;Source caveats — read before trusting this map&lt;/b&gt;&lt;br&gt;&amp;bull; RE-003 has &lt;b&gt;no step sequences&lt;/b&gt;. All step detail is code-derived, not RE-derived.&lt;br&gt;&amp;bull; 11 of 32 in-scope flows have &lt;b&gt;zero&lt;/b&gt; RE-010 rule/policy/invariant/authz coverage.&lt;br&gt;&amp;bull; RE-003 &apos;Executable Entry Evidence&apos; is unreliable for &lt;b&gt;screen&lt;/b&gt; mapping (F-096) —&lt;br&gt;&amp;nbsp;&amp;nbsp;backend endpoints checked out, frontend components did not.&lt;br&gt;&amp;bull; FLOW-028 has no endpoint and no established flow boundary (FLOW-DISCOVERY-UNCERTAINTY-001).&lt;br&gt;&amp;bull; &lt;b&gt;Regenerate, never hand-edit&lt;/b&gt; — see scripts/generate-flow-diagram.mjs." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="700" height="155" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="cap-005" name="CAP-005 · Resource Management"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="&lt;b&gt;CAP-005 · Resource Management&lt;/b&gt;" style="text;html=1;align=left;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="30" as="geometry"/></mxCell><object label="&amp;#8592; Capability Map" link="data:page/id,cap-map" id="bk"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=6;fontSize=12;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1380" y="20" width="180" height="30" as="geometry"/></mxCell></object><mxCell id="lg" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;font color=&apos;#82b366&apos;&gt;&amp;#9632;&lt;/font&gt; authenticated &amp;nbsp; &lt;font color=&apos;#b85450&apos;&gt;&amp;#9632;&lt;/font&gt; NO auth (defect) &amp;nbsp; &lt;font color=&apos;#d6b656&apos;&gt;&amp;#9632;&lt;/font&gt; public by design &amp;nbsp; &lt;font color=&apos;#d79b00&apos;&gt;&amp;#9632;&lt;/font&gt; provider signature &amp;nbsp; &lt;font color=&apos;#9673a6&apos;&gt;&amp;#9632;&lt;/font&gt; no endpoint (module) &amp;nbsp; &lt;font color=&apos;#999999&apos;&gt;&amp;#9632;&lt;/font&gt; test-only&lt;br&gt;Blue line = RE-006 transition &amp;nbsp; Red text = finding id" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1120" y="60" width="440" height="100" as="geometry"/></mxCell><mxCell id="n019" value="&lt;b&gt;FLOW-019&lt;/b&gt;&lt;br&gt;&lt;i&gt;Create Resource Pool&lt;/i&gt;&lt;br&gt;&lt;font size=&apos;9&apos; color=&apos;#555555&apos;&gt;POST /resource-pools&lt;/font&gt;&lt;br&gt;&lt;font size=&apos;8&apos; color=&apos;#b85450&apos;&gt;F-091 (fixed)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=4;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="250" height="86" as="geometry"/></mxCell><mxCell id="n020" value="&lt;b&gt;FLOW-020&lt;/b&gt;&lt;br&gt;&lt;i&gt;Update Resource Pool&lt;/i&gt;&lt;br&gt;&lt;font size=&apos;9&apos; color=&apos;#555555&apos;&gt;PATCH /resource-pools/:id&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=4;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="330" y="110" width="250" height="86" as="geometry"/></mxCell><mxCell id="n021" value="&lt;b&gt;FLOW-021&lt;/b&gt;&lt;br&gt;&lt;i&gt;Add Resource to Pool&lt;/i&gt;&lt;br&gt;&lt;font size=&apos;9&apos; color=&apos;#555555&apos;&gt;POST /resource-pools/:id/resources&lt;/font&gt;&lt;br&gt;&lt;font size=&apos;8&apos; color=&apos;#b85450&apos;&gt;F-091 (fixed)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=4;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="620" y="110" width="250" height="86" as="geometry"/></mxCell><mxCell id="n022" value="&lt;b&gt;FLOW-022&lt;/b&gt;&lt;br&gt;&lt;i&gt;Browse Branch Resource Pools&lt;/i&gt;&lt;br&gt;&lt;font size=&apos;9&apos; color=&apos;#555555&apos;&gt;GET /branches/:id/resource-pools&lt;/font&gt;&lt;br&gt;&lt;font size=&apos;8&apos; color=&apos;#b85450&apos;&gt;F-091 (fixed)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=4;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="250" height="86" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;" edge="1" parent="1" source="n019" target="n020"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;" edge="1" parent="1" source="n019" target="n021"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;" edge="1" parent="1" source="n019" target="n022"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="nt" value="&lt;b&gt;Gap flags&lt;/b&gt;&lt;br&gt;&amp;bull; &lt;b&gt;Zero RE-010 rule coverage&lt;/b&gt; for all four flows — no rules, policies, invariants, authz rules or transitions.&lt;br&gt;&amp;bull; RE-003/RE-004 never state what fields FLOW-019 accepts, what FLOW-020 validates, or how FIXED_INSTANCE vs POOLED changes behaviour.&lt;br&gt;&amp;bull; RE-004 called FLOW-019/021 &apos;auth uncertainty in Phase 4&apos;. That resolved as a &lt;b&gt;defect&lt;/b&gt;, not an unknown — 3 of 4 flows had no auth — and is now &lt;b&gt;fixed&lt;/b&gt; (F-091, aea242f). FLOW-019 additionally derives tenantId from the token rather than the body, per F-045.&lt;br&gt;&amp;bull; &lt;b&gt;FLOW-019 and FLOW-021 have no admin UI at all&lt;/b&gt; (F-098) — ResourcesPage can only update an existing pool. Every pool in this project came from seed scripts or the provisioning script. Real scale is 17+ batch groups, so the eventual UI needs bulk creation, not a single-pool form." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="1200" height="190" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="cap-006" name="CAP-006 · Availability &amp;amp; Scheduling"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="&lt;b&gt;CAP-006 · Availability &amp;amp; Scheduling&lt;/b&gt;" style="text;html=1;align=left;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="30" as="geometry"/></mxCell><object label="&amp;#8592; Capability Map" link="data:page/id,cap-map" id="bk"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=6;fontSize=12;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1380" y="20" width="180" height="30" as="geometry"/></mxCell></object><mxCell id="lg" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;font color=&apos;#82b366&apos;&gt;&amp;#9632;&lt;/font&gt; authenticated &amp;nbsp; &lt;font color=&apos;#b85450&apos;&gt;&amp;#9632;&lt;/font&gt; NO auth (defect) &amp;nbsp; &lt;font color=&apos;#d6b656&apos;&gt;&amp;#9632;&lt;/font&gt; public by design &amp;nbsp; &lt;font color=&apos;#d79b00&apos;&gt;&amp;#9632;&lt;/font&gt; provider signature &amp;nbsp; &lt;font color=&apos;#9673a6&apos;&gt;&amp;#9632;&lt;/font&gt; no endpoint (module) &amp;nbsp; &lt;font color=&apos;#999999&apos;&gt;&amp;#9632;&lt;/font&gt; test-only&lt;br&gt;Blue line = RE-006 transition &amp;nbsp; Red text = finding id" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1120" y="60" width="440" height="100" as="geometry"/></mxCell><mxCell id="n023" value="&lt;b&gt;FLOW-023&lt;/b&gt;&lt;br&gt;&lt;i&gt;Create Availability Window&lt;/i&gt;&lt;br&gt;&lt;font size=&apos;9&apos; color=&apos;#555555&apos;&gt;POST /resource-pools/:id/availability-windows&lt;/font&gt;&lt;br&gt;&lt;font size=&apos;8&apos; color=&apos;#b85450&apos;&gt;F-043 F-087 F-088 F-091 (fixed)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=4;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="250" height="86" as="geometry"/></mxCell><mxCell id="n025" value="&lt;b&gt;FLOW-025&lt;/b&gt;&lt;br&gt;&lt;i&gt;Manage Availability Patterns&lt;/i&gt;&lt;br&gt;&lt;font size=&apos;9&apos; color=&apos;#555555&apos;&gt;GET/POST/PATCH/DELETE .../availability-patterns&lt;/font&gt;&lt;br&gt;&lt;font size=&apos;8&apos; color=&apos;#b85450&apos;&gt;F-043 F-088&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=4;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="330" y="110" width="250" height="86" as="geometry"/></mxCell><mxCell id="n026" value="&lt;b&gt;FLOW-026&lt;/b&gt;&lt;br&gt;&lt;i&gt;Manage Availability Overrides&lt;/i&gt;&lt;br&gt;&lt;font size=&apos;9&apos; color=&apos;#555555&apos;&gt;GET/POST/PATCH/DELETE .../availability-overrides&lt;/font&gt;&lt;br&gt;&lt;font size=&apos;8&apos; color=&apos;#b85450&apos;&gt;F-043 F-088&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=4;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="620" y="110" width="250" height="86" as="geometry"/></mxCell><mxCell id="n027" value="&lt;b&gt;FLOW-027&lt;/b&gt;&lt;br&gt;&lt;i&gt;Block Availability Window&lt;/i&gt;&lt;br&gt;&lt;font size=&apos;9&apos; color=&apos;#555555&apos;&gt;POST /blocked-windows&lt;/font&gt;&lt;br&gt;&lt;font size=&apos;8&apos; color=&apos;#b85450&apos;&gt;F-051 F-091 (fixed)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=4;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="250" height="86" as="geometry"/></mxCell><mxCell id="n028" value="&lt;b&gt;FLOW-028&lt;/b&gt;&lt;br&gt;&lt;i&gt;Generate Availability&lt;/i&gt;&lt;br&gt;&lt;font size=&apos;9&apos; color=&apos;#555555&apos;&gt;(no endpoint - availabilityGeneration.ts)&lt;/font&gt;&lt;br&gt;&lt;font size=&apos;8&apos; color=&apos;#b85450&apos;&gt;F-046 F-088&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=4;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="330" y="240" width="250" height="86" as="geometry"/></mxCell><mxCell id="n024" value="&lt;b&gt;FLOW-024&lt;/b&gt;&lt;br&gt;&lt;i&gt;Browse Availability&lt;/i&gt;&lt;br&gt;&lt;font size=&apos;9&apos; color=&apos;#555555&apos;&gt;GET /resource-pools/:id/availability&lt;/font&gt;&lt;br&gt;&lt;font size=&apos;8&apos; color=&apos;#b85450&apos;&gt;F-051 F-080 F-088&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=4;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="620" y="240" width="250" height="86" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;" edge="1" parent="1" source="n023" target="n024"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;" edge="1" parent="1" source="n025" target="n028"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;" edge="1" parent="1" source="n026" target="n028"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;" edge="1" parent="1" source="n027" target="n024"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;" edge="1" parent="1" source="n028" target="n024"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="nt" value="&lt;b&gt;Gap flags&lt;/b&gt;&lt;br&gt;&amp;bull; &lt;b&gt;FLOW-028 has no endpoint and no established flow boundary&lt;/b&gt; (FLOW-DISCOVERY-UNCERTAINTY-001). It is a module invoked lazily by 024/045/047 — do not draw it with an initiator.&lt;br&gt;&amp;bull; FLOW-024 remains public &lt;i&gt;by design&lt;/i&gt; (BR-048). FLOW-023 and FLOW-027 were unauthenticated by defect and are now guarded (F-091, aea242f).&lt;br&gt;&amp;bull; Whole capability is downstream of F-088 (Branch.timezone unreachable; every branch reports UTC).&lt;br&gt;&amp;bull; Only FLOW-024 has RE-010 rule coverage; the other five have none." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="1200" height="190" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="cap-008" name="CAP-008 · Booking Rule Configuration"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="&lt;b&gt;CAP-008 · Booking Rule Configuration&lt;/b&gt;" style="text;html=1;align=left;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="30" as="geometry"/></mxCell><object label="&amp;#8592; Capability Map" link="data:page/id,cap-map" id="bk"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=6;fontSize=12;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1380" y="20" width="180" height="30" as="geometry"/></mxCell></object><mxCell id="lg" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;font color=&apos;#82b366&apos;&gt;&amp;#9632;&lt;/font&gt; authenticated &amp;nbsp; &lt;font color=&apos;#b85450&apos;&gt;&amp;#9632;&lt;/font&gt; NO auth (defect) &amp;nbsp; &lt;font color=&apos;#d6b656&apos;&gt;&amp;#9632;&lt;/font&gt; public by design &amp;nbsp; &lt;font color=&apos;#d79b00&apos;&gt;&amp;#9632;&lt;/font&gt; provider signature &amp;nbsp; &lt;font color=&apos;#9673a6&apos;&gt;&amp;#9632;&lt;/font&gt; no endpoint (module) &amp;nbsp; &lt;font color=&apos;#999999&apos;&gt;&amp;#9632;&lt;/font&gt; test-only&lt;br&gt;Blue line = RE-006 transition &amp;nbsp; Red text = finding id" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1120" y="60" width="440" height="100" as="geometry"/></mxCell><mxCell id="n038" value="&lt;b&gt;FLOW-038&lt;/b&gt;&lt;br&gt;&lt;i&gt;Create Booking Rule&lt;/i&gt;&lt;br&gt;&lt;font size=&apos;9&apos; color=&apos;#555555&apos;&gt;POST /booking-rules&lt;/font&gt;&lt;br&gt;&lt;font size=&apos;8&apos; color=&apos;#b85450&apos;&gt;F-080&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=4;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="250" height="86" as="geometry"/></mxCell><mxCell id="n039" value="&lt;b&gt;FLOW-039&lt;/b&gt;&lt;br&gt;&lt;i&gt;Update Resource Pool Booking Rule&lt;/i&gt;&lt;br&gt;&lt;font size=&apos;9&apos; color=&apos;#555555&apos;&gt;PUT /resource-pools/:id/booking-rule&lt;/font&gt;&lt;br&gt;&lt;font size=&apos;8&apos; color=&apos;#b85450&apos;&gt;F-065 F-063&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=4;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="330" y="110" width="250" height="86" as="geometry"/></mxCell><mxCell id="nt" value="&lt;b&gt;Gap flags — the thinnest capability in the set&lt;/b&gt;&lt;br&gt;&amp;bull; &lt;b&gt;Zero RE-010 rule coverage&lt;/b&gt; for both flows, and &lt;b&gt;no RE-004 journey of its own&lt;/b&gt; — RE-011 folds 038/039 into Availability Management.&lt;br&gt;&amp;bull; RE-003/RE-004 never enumerate a single field of &lt;code&gt;BookingRule&lt;/code&gt;, despite this capability governing the config behind &lt;b&gt;F-005&lt;/b&gt; (lowOccupancyThresholdPct), &lt;b&gt;F-051&lt;/b&gt; (guestOpenWindowDays), and &lt;b&gt;F-065&lt;/b&gt; (gracePeriodMinutes vs guestAccessCutoffMinutes).&lt;br&gt;&amp;bull; Any rule-semantics view must be built from schema.prisma and the handlers. &lt;b&gt;The RE set does not contain the material.&lt;/b&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="1200" height="190" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="cap-007" name="CAP-007 · Booking Management"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="&lt;b&gt;CAP-007 · Booking Management&lt;/b&gt;" style="text;html=1;align=left;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="30" as="geometry"/></mxCell><object label="&amp;#8592; Capability Map" link="data:page/id,cap-map" id="bk"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=6;fontSize=12;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1380" y="20" width="180" height="30" as="geometry"/></mxCell></object><mxCell id="lg" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;font color=&apos;#82b366&apos;&gt;&amp;#9632;&lt;/font&gt; authenticated &amp;nbsp; &lt;font color=&apos;#b85450&apos;&gt;&amp;#9632;&lt;/font&gt; NO auth (defect) &amp;nbsp; &lt;font color=&apos;#d6b656&apos;&gt;&amp;#9632;&lt;/font&gt; public by design &amp;nbsp; &lt;font color=&apos;#d79b00&apos;&gt;&amp;#9632;&lt;/font&gt; provider signature &amp;nbsp; &lt;font color=&apos;#9673a6&apos;&gt;&amp;#9632;&lt;/font&gt; no endpoint (module) &amp;nbsp; &lt;font color=&apos;#999999&apos;&gt;&amp;#9632;&lt;/font&gt; test-only&lt;br&gt;Blue line = RE-006 transition &amp;nbsp; Red text = finding id" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1120" y="60" width="440" height="100" as="geometry"/></mxCell><mxCell id="n029" value="&lt;b&gt;FLOW-029&lt;/b&gt;&lt;br&gt;&lt;i&gt;Create Booking&lt;/i&gt;&lt;br&gt;&lt;font size=&apos;9&apos; color=&apos;#555555&apos;&gt;POST /bookings&lt;/font&gt;&lt;br&gt;&lt;font size=&apos;8&apos; color=&apos;#6c8ebf&apos;&gt;TRANSITION-BOOKING-001&lt;/font&gt;&lt;br&gt;&lt;font size=&apos;8&apos; color=&apos;#b85450&apos;&gt;F-023 F-028 F-080&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=4;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="250" height="86" as="geometry"/></mxCell><mxCell id="n034" value="&lt;b&gt;FLOW-034&lt;/b&gt;&lt;br&gt;&lt;i&gt;Confirm Booking&lt;/i&gt;&lt;br&gt;&lt;font size=&apos;9&apos; color=&apos;#555555&apos;&gt;POST /bookings/:id/confirm&lt;/font&gt;&lt;br&gt;&lt;font size=&apos;8&apos; color=&apos;#6c8ebf&apos;&gt;TRANSITION-BOOKING-003 / -004&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=4;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="330" y="110" width="250" height="86" as="geometry"/></mxCell><mxCell id="n035" value="&lt;b&gt;FLOW-035&lt;/b&gt;&lt;br&gt;&lt;i&gt;Check In Booking&lt;/i&gt;&lt;br&gt;&lt;font size=&apos;9&apos; color=&apos;#555555&apos;&gt;POST /bookings/:id/check-in&lt;/font&gt;&lt;br&gt;&lt;font size=&apos;8&apos; color=&apos;#6c8ebf&apos;&gt;TRANSITION-BOOKING-005&lt;/font&gt;&lt;br&gt;&lt;font size=&apos;8&apos; color=&apos;#b85450&apos;&gt;F-090 (fixed) F-093 F-094&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=4;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="620" y="110" width="250" height="86" as="geometry"/></mxCell><mxCell id="n031" value="&lt;b&gt;FLOW-031&lt;/b&gt;&lt;br&gt;&lt;i&gt;View Booking&lt;/i&gt;&lt;br&gt;&lt;font size=&apos;9&apos; color=&apos;#555555&apos;&gt;GET /bookings/:id&lt;/font&gt;&lt;br&gt;&lt;font size=&apos;8&apos; color=&apos;#b85450&apos;&gt;F-037&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=4;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="250" height="86" as="geometry"/></mxCell><mxCell id="n032" value="&lt;b&gt;FLOW-032&lt;/b&gt;&lt;br&gt;&lt;i&gt;View My Bookings&lt;/i&gt;&lt;br&gt;&lt;font size=&apos;9&apos; color=&apos;#555555&apos;&gt;GET /bookings/my&lt;/font&gt;&lt;br&gt;&lt;font size=&apos;8&apos; color=&apos;#b85450&apos;&gt;F-093 F-094&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=4;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="330" y="240" width="250" height="86" as="geometry"/></mxCell><mxCell id="n033" value="&lt;b&gt;FLOW-033&lt;/b&gt;&lt;br&gt;&lt;i&gt;View Admin Bookings&lt;/i&gt;&lt;br&gt;&lt;font size=&apos;9&apos; color=&apos;#555555&apos;&gt;GET /bookings/admin&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=4;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="620" y="240" width="250" height="86" as="geometry"/></mxCell><mxCell id="n036" value="&lt;b&gt;FLOW-036&lt;/b&gt;&lt;br&gt;&lt;i&gt;Preview Booking Cancellation&lt;/i&gt;&lt;br&gt;&lt;font size=&apos;9&apos; color=&apos;#555555&apos;&gt;GET /bookings/:id/cancel-preview&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=4;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="250" height="86" as="geometry"/></mxCell><mxCell id="n037" value="&lt;b&gt;FLOW-037&lt;/b&gt;&lt;br&gt;&lt;i&gt;Cancel Booking&lt;/i&gt;&lt;br&gt;&lt;font size=&apos;9&apos; color=&apos;#555555&apos;&gt;POST /bookings/:id/cancel&lt;/font&gt;&lt;br&gt;&lt;font size=&apos;8&apos; color=&apos;#6c8ebf&apos;&gt;TRANSITION-BOOKING-006 / -007 / -008&lt;/font&gt;&lt;br&gt;&lt;font size=&apos;8&apos; color=&apos;#b85450&apos;&gt;F-092&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=4;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="330" y="370" width="250" height="86" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;" edge="1" parent="1" source="n029" target="n034"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;" edge="1" parent="1" source="n034" target="n035"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;" edge="1" parent="1" source="n034" target="n031"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;" edge="1" parent="1" source="n034" target="n032"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;" edge="1" parent="1" source="n034" target="n033"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;" edge="1" parent="1" source="n034" target="n036"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;" edge="1" parent="1" source="n036" target="n037"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="nt" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;&amp;bull; FLOW-035 reflects the &lt;b&gt;F-090 fix as merged (0e94800)&lt;/b&gt;: requireInternalKey || requireUserJwt, then requireBookingAccess before the idempotent early-return. Any earlier snapshot shows no auth at all.&lt;br&gt;&amp;bull; FLOW-034 does not verify hold expiry or payment state (STATE-CONFLICT-002) — payment capture is treated as the upstream precondition.&lt;br&gt;&amp;bull; FLOW-036 computes without writing; FLOW-037 persists status + refundAmount but does &lt;b&gt;not&lt;/b&gt; create a Refund row.&lt;br&gt;&amp;bull; Cancel accepts only HELD/CONFIRMED, so CHECKED_IN is terminal for the refund path (drives F-093)." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="1200" height="190" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="cap-010" name="CAP-010 · Occupancy &amp;amp; Capacity Release"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="&lt;b&gt;CAP-010 · Occupancy &amp;amp; Capacity Release&lt;/b&gt; &amp;nbsp;&lt;font size=&apos;10&apos; color=&apos;#b85450&apos;&gt;grouped by real screen (F-096 correction)&lt;/font&gt;" style="text;html=1;align=left;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="30" as="geometry"/></mxCell><object label="&amp;#8592; Capability Map" link="data:page/id,cap-map" id="bk"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=6;fontSize=12;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1380" y="20" width="180" height="30" as="geometry"/></mxCell></object><mxCell id="lg" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;font color=&apos;#82b366&apos;&gt;&amp;#9632;&lt;/font&gt; authenticated &amp;nbsp; &lt;font color=&apos;#b85450&apos;&gt;&amp;#9632;&lt;/font&gt; NO auth (defect) &amp;nbsp; &lt;font color=&apos;#d6b656&apos;&gt;&amp;#9632;&lt;/font&gt; public by design &amp;nbsp; &lt;font color=&apos;#d79b00&apos;&gt;&amp;#9632;&lt;/font&gt; provider signature &amp;nbsp; &lt;font color=&apos;#9673a6&apos;&gt;&amp;#9632;&lt;/font&gt; no endpoint (module) &amp;nbsp; &lt;font color=&apos;#999999&apos;&gt;&amp;#9632;&lt;/font&gt; test-only&lt;br&gt;Blue line = RE-006 transition &amp;nbsp; Red text = finding id" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1120" y="60" width="440" height="100" as="geometry"/></mxCell><mxCell id="g0" value="Overview()  &amp;nbsp;&lt;font size=&apos;9&apos;&gt;admin-web main.tsx:610&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;verticalAlign=top;fontSize=11;fontStyle=1;fillColor=#f0f7ff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="620" height="180" as="geometry"/></mxCell><mxCell id="n045" value="&lt;b&gt;FLOW-045&lt;/b&gt;&lt;br&gt;&lt;i&gt;View Guest Occupancy&lt;/i&gt;&lt;br&gt;&lt;font size=&apos;9&apos; color=&apos;#555555&apos;&gt;GET /branches/:id/guest-occupancy&lt;/font&gt;&lt;br&gt;&lt;font size=&apos;8&apos; color=&apos;#b85450&apos;&gt;F-063&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=4;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="160" width="270" height="86" as="geometry"/></mxCell><mxCell id="n046" value="&lt;b&gt;FLOW-046&lt;/b&gt;&lt;br&gt;&lt;i&gt;View Member Attendance&lt;/i&gt;&lt;br&gt;&lt;font size=&apos;9&apos; color=&apos;#555555&apos;&gt;GET /branches/:id/member-attendance&lt;/font&gt;&lt;br&gt;&lt;font size=&apos;8&apos; color=&apos;#b85450&apos;&gt;F-042 F-063&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=4;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="350" y="160" width="270" height="86" as="geometry"/></mxCell><mxCell id="g1" value="OccupancyPage()  &amp;nbsp;&lt;font size=&apos;9&apos;&gt;main.tsx:1236 &amp;bull; nav label &quot;Low Occupancy&quot; (main.tsx:430)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;verticalAlign=top;fontSize=11;fontStyle=1;fillColor=#fff8f0;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="700" y="120" width="620" height="180" as="geometry"/></mxCell><mxCell id="n047" value="&lt;b&gt;FLOW-047&lt;/b&gt;&lt;br&gt;&lt;i&gt;View Resource Pool Occupancy&lt;/i&gt;&lt;br&gt;&lt;font size=&apos;9&apos; color=&apos;#555555&apos;&gt;GET /resource-pools/:id/occupancy&lt;/font&gt;&lt;br&gt;&lt;font size=&apos;8&apos; color=&apos;#b85450&apos;&gt;F-005 F-031 F-062 F-091 (fixed)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=4;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="720" y="160" width="270" height="86" as="geometry"/></mxCell><mxCell id="n048" value="&lt;b&gt;FLOW-048&lt;/b&gt;&lt;br&gt;&lt;i&gt;Release Capacity&lt;/i&gt;&lt;br&gt;&lt;font size=&apos;9&apos; color=&apos;#555555&apos;&gt;POST /resource-pools/:id/windows/:windowId/release&lt;/font&gt;&lt;br&gt;&lt;font size=&apos;8&apos; color=&apos;#b85450&apos;&gt;F-023 F-044 F-065&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=4;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1010" y="160" width="270" height="86" as="geometry"/></mxCell><mxCell id="g2" value="No admin UI  &amp;nbsp;&lt;font size=&apos;9&apos;&gt;internal-key endpoint only&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;verticalAlign=top;fontSize=11;fontStyle=1;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1360" y="120" width="320" height="180" as="geometry"/></mxCell><mxCell id="n049" value="&lt;b&gt;FLOW-049&lt;/b&gt;&lt;br&gt;&lt;i&gt;Run Booking Sweep&lt;/i&gt;&lt;br&gt;&lt;font size=&apos;9&apos; color=&apos;#555555&apos;&gt;POST /bookings/sweep&lt;/font&gt;&lt;br&gt;&lt;font size=&apos;8&apos; color=&apos;#6c8ebf&apos;&gt;TRANSITION-BOOKING-009 / -012&lt;/font&gt;&lt;br&gt;&lt;font size=&apos;8&apos; color=&apos;#b85450&apos;&gt;F-044 F-046 F-063 F-065 F-066 F-073&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=4;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1380" y="160" width="270" height="86" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;" edge="1" parent="1" source="n047" target="n048"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="nt" value="&lt;b&gt;F-096 correction applied.&lt;/b&gt; RE-003&apos;s Executable Entry Evidence claims &lt;code&gt;OccupancyPage&lt;/code&gt; for all four of FLOW-045/046/047/048. Verified against source: &lt;b&gt;045 and 046 actually render in Overview()&lt;/b&gt; (main.tsx:618-620 and :623-625); only 047 and 048 are on OccupancyPage. Cross-corroborated by the register&apos;s own F-041.&lt;br&gt;&lt;br&gt;&lt;b&gt;FLOW-046 inclusion:&lt;/b&gt; kept here on RE-003&apos;s Primary Capability tag (CAP-010). RE-004 places it in the &lt;i&gt;Member Assignment &amp;amp; Attendance&lt;/i&gt; journey — that is an &lt;b&gt;orthogonal axis, not a contradiction&lt;/b&gt;: capability vs journey. It pairs with FLOW-045 on the same screen, which is the strongest argument for keeping it in this view.&lt;br&gt;&lt;br&gt;&lt;b&gt;Two capacity formulas, deliberately different.&lt;/b&gt; computePoolGuestOccupancy filters isMemberBooking:false (intentional, per F-035/F-041/F-063); FLOW-024 counts HELD+CONFIRMED regardless. This is STATE-CONFLICT-001 — &lt;b&gt;do not draw 045 and 024 as sharing a computation&lt;/b&gt;." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="1200" height="190" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="cap-011" name="CAP-011 / CAP-012 · Payment &amp;amp; Refund"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="&lt;b&gt;CAP-011 / CAP-012 · Payment &amp;amp; Refund&lt;/b&gt;" style="text;html=1;align=left;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="30" as="geometry"/></mxCell><object label="&amp;#8592; Capability Map" link="data:page/id,cap-map" id="bk"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=6;fontSize=12;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1380" y="20" width="180" height="30" as="geometry"/></mxCell></object><mxCell id="lg" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;font color=&apos;#82b366&apos;&gt;&amp;#9632;&lt;/font&gt; authenticated &amp;nbsp; &lt;font color=&apos;#b85450&apos;&gt;&amp;#9632;&lt;/font&gt; NO auth (defect) &amp;nbsp; &lt;font color=&apos;#d6b656&apos;&gt;&amp;#9632;&lt;/font&gt; public by design &amp;nbsp; &lt;font color=&apos;#d79b00&apos;&gt;&amp;#9632;&lt;/font&gt; provider signature &amp;nbsp; &lt;font color=&apos;#9673a6&apos;&gt;&amp;#9632;&lt;/font&gt; no endpoint (module) &amp;nbsp; &lt;font color=&apos;#999999&apos;&gt;&amp;#9632;&lt;/font&gt; test-only&lt;br&gt;Blue line = RE-006 transition &amp;nbsp; Red text = finding id" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1120" y="60" width="440" height="100" as="geometry"/></mxCell><mxCell id="n050" value="&lt;b&gt;FLOW-050&lt;/b&gt;&lt;br&gt;&lt;i&gt;Create Payment Intent&lt;/i&gt;&lt;br&gt;&lt;font size=&apos;9&apos; color=&apos;#555555&apos;&gt;POST /payments/intents&lt;/font&gt;&lt;br&gt;&lt;font size=&apos;8&apos; color=&apos;#b85450&apos;&gt;F-026 F-037 F-081&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=4;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="250" height="86" as="geometry"/></mxCell><mxCell id="n051" value="&lt;b&gt;FLOW-051&lt;/b&gt;&lt;br&gt;&lt;i&gt;Create Payment Order&lt;/i&gt;&lt;br&gt;&lt;font size=&apos;9&apos; color=&apos;#555555&apos;&gt;POST /payments/create-order&lt;/font&gt;&lt;br&gt;&lt;font size=&apos;8&apos; color=&apos;#6c8ebf&apos;&gt;TRANSITION-PAYMENT-INTENT-003&lt;/font&gt;&lt;br&gt;&lt;font size=&apos;8&apos; color=&apos;#b85450&apos;&gt;F-026 F-027 F-038 F-081&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=4;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="330" y="110" width="250" height="86" as="geometry"/></mxCell><mxCell id="n052" value="&lt;b&gt;FLOW-052&lt;/b&gt;&lt;br&gt;&lt;i&gt;Verify Payment&lt;/i&gt;&lt;br&gt;&lt;font size=&apos;9&apos; color=&apos;#555555&apos;&gt;POST /payments/verify-payment&lt;/font&gt;&lt;br&gt;&lt;font size=&apos;8&apos; color=&apos;#6c8ebf&apos;&gt;TRANSITION-PAYMENT-INTENT-001&lt;/font&gt;&lt;br&gt;&lt;font size=&apos;8&apos; color=&apos;#b85450&apos;&gt;F-034 F-038 F-050 F-081&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=4;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="620" y="110" width="250" height="86" as="geometry"/></mxCell><mxCell id="n054" value="&lt;b&gt;FLOW-054&lt;/b&gt;&lt;br&gt;&lt;i&gt;Process Razorpay Payment Webhook&lt;/i&gt;&lt;br&gt;&lt;font size=&apos;9&apos; color=&apos;#555555&apos;&gt;POST /webhooks/razorpay&lt;/font&gt;&lt;br&gt;&lt;font size=&apos;8&apos; color=&apos;#6c8ebf&apos;&gt;TRANSITION-PAYMENT-INTENT-002&lt;/font&gt;&lt;br&gt;&lt;font size=&apos;8&apos; color=&apos;#b85450&apos;&gt;F-026 F-033 F-081 F-082&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=4;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="910" y="110" width="250" height="86" as="geometry"/></mxCell><mxCell id="n058" value="&lt;b&gt;FLOW-058&lt;/b&gt;&lt;br&gt;&lt;i&gt;Simulate Payment Capture&lt;/i&gt;&lt;br&gt;&lt;font size=&apos;9&apos; color=&apos;#555555&apos;&gt;POST /payments/test/simulate-capture&lt;/font&gt;&lt;br&gt;&lt;font size=&apos;8&apos; color=&apos;#b85450&apos;&gt;(test-only)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=4;fontSize=10;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="250" height="86" as="geometry"/></mxCell><mxCell id="n059" value="&lt;b&gt;FLOW-059&lt;/b&gt;&lt;br&gt;&lt;i&gt;Create Refund&lt;/i&gt;&lt;br&gt;&lt;font size=&apos;9&apos; color=&apos;#555555&apos;&gt;POST /refunds&lt;/font&gt;&lt;br&gt;&lt;font size=&apos;8&apos; color=&apos;#6c8ebf&apos;&gt;TRANSITION-REFUND-001&lt;/font&gt;&lt;br&gt;&lt;font size=&apos;8&apos; color=&apos;#b85450&apos;&gt;F-026 F-082 F-097 (fixed)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=4;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="330" y="240" width="250" height="86" as="geometry"/></mxCell><mxCell id="n060" value="&lt;b&gt;FLOW-060&lt;/b&gt;&lt;br&gt;&lt;i&gt;Override Refund&lt;/i&gt;&lt;br&gt;&lt;font size=&apos;9&apos; color=&apos;#555555&apos;&gt;POST /refunds/override&lt;/font&gt;&lt;br&gt;&lt;font size=&apos;8&apos; color=&apos;#b85450&apos;&gt;F-026&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=4;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="620" y="240" width="250" height="86" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;" edge="1" parent="1" source="n050" target="n051"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;" edge="1" parent="1" source="n051" target="n052"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;" edge="1" parent="1" source="n051" target="n054"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="test only" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;" edge="1" parent="1" source="n051" target="n058"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="test only" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;" edge="1" parent="1" source="n058" target="n054"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;" edge="1" parent="1" source="n059" target="n060"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="nt" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;&amp;bull; &lt;b&gt;FLOW-059 real handler is payment/src/index.ts:595-679&lt;/b&gt;. Lines 696-820 belong to /payment-links (FLOW-056) and were misattributed by the first mechanical pass.&lt;br&gt;&amp;bull; &lt;b&gt;F-097 fixed (000ab4b)&lt;/b&gt; — FLOW-059 now uses requirePaymentLinkAdmin (internal key OR owner/branch_manager JWT). Its sibling FLOW-060 keeps a JWT-only guard because it records an accountable adminId.&lt;br&gt;&amp;bull; FLOW-052 and FLOW-054 both capture then call Slot Engine FLOW-034 across a service boundary — non-atomic (XFLOW-GAP-001, INTEGRATION-FINDING-001).&lt;br&gt;&amp;bull; FLOW-058 is test-only and calls the service&apos;s &lt;b&gt;own&lt;/b&gt; webhook endpoint. Dashed test path, not production." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="1200" height="190" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="guest-booking" name="Journey · Guest Booking + Payment"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="&lt;b&gt;Cross-flow journey · Guest Booking + Payment (end-to-end)&lt;/b&gt;" style="text;html=1;align=left;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry"/></mxCell><object label="&amp;#8592; Capability Map" link="data:page/id,cap-map" id="bk"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=6;fontSize=12;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1380" y="20" width="180" height="30" as="geometry"/></mxCell></object><mxCell id="lg" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;font color=&apos;#82b366&apos;&gt;&amp;#9632;&lt;/font&gt; authenticated &amp;nbsp; &lt;font color=&apos;#b85450&apos;&gt;&amp;#9632;&lt;/font&gt; NO auth (defect) &amp;nbsp; &lt;font color=&apos;#d6b656&apos;&gt;&amp;#9632;&lt;/font&gt; public by design &amp;nbsp; &lt;font color=&apos;#d79b00&apos;&gt;&amp;#9632;&lt;/font&gt; provider signature &amp;nbsp; &lt;font color=&apos;#9673a6&apos;&gt;&amp;#9632;&lt;/font&gt; no endpoint (module) &amp;nbsp; &lt;font color=&apos;#999999&apos;&gt;&amp;#9632;&lt;/font&gt; test-only&lt;br&gt;Blue line = RE-006 transition &amp;nbsp; Red text = finding id" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1120" y="60" width="440" height="100" as="geometry"/></mxCell><mxCell id="j024" value="&lt;b&gt;FLOW-024&lt;/b&gt;&lt;br&gt;&lt;i&gt;Browse Availability&lt;/i&gt;&lt;br&gt;&lt;font size=&apos;9&apos; color=&apos;#555555&apos;&gt;GET /resource-pools/:id/availability&lt;/font&gt;&lt;br&gt;&lt;font size=&apos;8&apos; color=&apos;#b85450&apos;&gt;F-051 F-080 F-088&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=4;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="250" height="86" as="geometry"/></mxCell><mxCell id="j029" value="&lt;b&gt;FLOW-029&lt;/b&gt;&lt;br&gt;&lt;i&gt;Create Booking&lt;/i&gt;&lt;br&gt;&lt;font size=&apos;9&apos; color=&apos;#555555&apos;&gt;POST /bookings&lt;/font&gt;&lt;br&gt;&lt;font size=&apos;8&apos; color=&apos;#6c8ebf&apos;&gt;TRANSITION-BOOKING-001&lt;/font&gt;&lt;br&gt;&lt;font size=&apos;8&apos; color=&apos;#b85450&apos;&gt;F-023 F-028 F-080&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=4;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="340" y="130" width="250" height="86" as="geometry"/></mxCell><mxCell id="j050" value="&lt;b&gt;FLOW-050&lt;/b&gt;&lt;br&gt;&lt;i&gt;Create Payment Intent&lt;/i&gt;&lt;br&gt;&lt;font 