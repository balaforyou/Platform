# admin-v2 dev sign-in — enables the `dev-admin-token-<email>` bypass on
# /auth/admin/google/verify (no Google round-trip). Default-off / fail-closed; set only
# for local dev + CI/e2e. NOT NODE_ENV-gated (the demo VM runs NODE_ENV=development).
# Production must leave this unset.
# ADMIN_DEV_LOGIN=true